# Keep actual values in .env, which is ignored by Git.
OPENAI_API_KEY=
# Optional: choose another OpenAI model supported by your API account.
OPENAI_MODEL=gpt-4o-mini
GMAIL_CLIENT_SECRET_FILE=data/google-oauth-client.json
GMAIL_TOKEN_FILE=data/oauth-token.json
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional SMTP settings for daily email digests (terminal digests need none).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DIGEST_TO_EMAIL=

